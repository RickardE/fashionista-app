# --- Database -------------------------------------------------------------
# Local: `npm run db:up` starts Postgres+pgvector from docker-compose.yml.
DATABASE_URL=postgres://styleai:styleai@localhost:5433/styleai
# Hosted (Neon): DATABASE_URL = the *pooled* string (host contains "-pooler"),
# used by the app. DATABASE_URL_UNPOOLED = the direct string, used by CLI
# scripts (migrations, imports, enrichment). Keep these in .env.neon and run
# scripts with ENV_FILE=.env.neon.
# DATABASE_URL_UNPOOLED=

# --- Product sources ------------------------------------------------------
# Adtraction product feed URL for Johnells SE (contains your affiliate token —
# never commit the real value). Quote it — the URL contains "&".
ADTRACTION_JOHNELLS_FEED_URL=""

# --- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- AI enrichment --------------------------------------------------------
# Credentials for whichever model providers you run enrichment with.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional defaults for products:enrich* (flags override these).
ENRICHMENT_PROVIDER=""
ENRICHMENT_MODEL=""
ENRICHMENT_EFFORT=""
# Optional pricing for models not in src/server/enrichment/pricing.ts (USD per 1M tokens), e.g.
# ENRICHMENT_PRICING_JSON='{"openai:some-model":{"input":1.25,"output":10,"cacheRead":0.125}}'
