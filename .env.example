# --- Database -------------------------------------------------------------
# Local: `npm run db:up` starts Postgres+pgvector from docker-compose.yml.
DATABASE_URL=postgres://styleai:styleai@localhost:5433/styleai
# Hosted (Neon): DATABASE_URL = the *pooled* string (host contains "-pooler"),
# used by the app. DATABASE_URL_UNPOOLED = the direct string, used by CLI
# scripts (migrations, imports, enrichment). Keep these in .env.neon and run
# scripts with ENV_FILE=.env.neon.
# DATABASE_URL_UNPOOLED=

# --- Product sources ------------------------------------------------------
# Adtraction product feed URL for Johnells SE (contains your affiliate token —
# never commit the real value). Quote it — the URL contains "&".
ADTRACTION_JOHNELLS_FEED_URL=""

# --- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- AI enrichment --------------------------------------------------------
# Credentials for whichever model providers you run enrichment with.
# Use a key created inside a workspace (sk-ant-api03-…). Only for keys that are
# not workspace-scoped: set the workspace to bill/route requests to.
ANTHROPIC_API_KEY=""
ANTHROPIC_WORKSPACE_ID=""
OPENAI_API_KEY=""
# Optional defaults for products:enrich* (flags override these).
ENRICHMENT_PROVIDER=""
ENRICHMENT_MODEL=""
ENRICHMENT_EFFORT=""
# Optional pricing for models not in src/server/enrichment/pricing.ts (USD per 1M tokens), e.g.
# ENRICHMENT_PRICING_JSON='{"openai:some-model":{"input":1.25,"output":10,"cacheRead":0.125}}'

# --- Test catalogue (controlled user tests) --------------------------------
# Off unless set. When set to a catalogue name (src/server/products/test-catalogues/<name>.json),
# every product query — feeds, outfit candidates, search, lookups by id — only sees the listed
# products that have a current, completed enrichment. An unknown name fails closed (errors).
# TEST_CATALOGUE=user-test-1

# --- Accounts (Better Auth, Google sign-in only) ---------------------------
# Signs session cookies and encrypts stored OAuth tokens. Generate with:
#   openssl rand -base64 32
# Use a different value per environment; changing it signs everyone out.
BETTER_AUTH_SECRET=
# The app's public origin, e.g. http://localhost:3000 or https://<production domain>.
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
